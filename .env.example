# Copy to .env and adjust. Never commit .env.
APP_ENV=development            # development | staging | production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value
DATABASE_URL=sqlite:///./data/praktikumfinder.db
BASE_URL=http://localhost:8000
SECURE_COOKIES=false           # must be true in production (HTTPS)
SEED_DEMO_DATA=false           # true = add 12 fictional demo listings for trying the app out
LOAD_GERMANY_POSTCODES=true    # load the bundled Germany-wide postcodes (GeoNames, CC BY 4.0) on first start
SCRAPE_INTERVAL_HOURS=0        # 0 = only manual runs; e.g. 24 = daily run of enabled sources
SCRAPER_USER_AGENT=PraktikumFinderBot/0.1 (+https://your-domain.example/bot; contact: you@your-domain.example)
SCRAPER_MIN_DELAY_SECONDS=2
LOG_LEVEL=INFO
DOMAIN=praktikum.your-domain.example   # used by Caddy in the production profile
BACKUP_PASSPHRASE=                      # used by scripts/backup.sh to encrypt backups
